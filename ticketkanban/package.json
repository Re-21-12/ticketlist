{
  "name": "ticketkanban",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --allowed-hosts=all",
    "start:bff": "ng serve --host 0.0.0.0 --port 4200 --allowed-hosts=all --configuration bff",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:prod": "node scripts/serve-prod.js",
    "fetch:yolo": "node scripts/fetch-yolo-model.mjs",
    "test": "ng test",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@casl/ability": "^7.0.1",
    "@casl/angular": "^10.0.3",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-styled": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "animejs": "^4.5.0",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.12",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
