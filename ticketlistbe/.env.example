# ── ticketlistbe · variables de entorno (desarrollo local) ─────────────────────────────────────────
# `bun run start:dev` NO lee este archivo por sí solo: exporta las variables o usa `bun --env-file=.env`.
# Todo tiene valor por defecto en desarrollo; en production `loadEnv` EXIGE las marcadas (obligatoria).
# Detalle y producción: deploy/DOKPLOY.md · docs/standard/persistence.md

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200

# ── Persistencia (TypeORM + Postgres). Sin DATABASE_URL todo vive en memoria ────────────────────────
#   docker compose up -d postgres redis   →   Postgres :5433 · Redis :6380
DATABASE_URL=postgres://ticketit:ticketit-dev@localhost:5433/ticketit
DB_AUTO_MIGRATE=true
# DB_PERSISTENCE=true        # (por defecto activa si hay DATABASE_URL)
# DB_RESET_ON_START=false    # SOLO pruebas: vacía las tablas al arrancar
# DB_LOGGING=false

# ── Bucket de evidencia (MinIO / S3): imágenes, PDF, Excel, CSV y videos cortos (≤ 5 min) de los tickets ─────────
# `docker compose up -d minio` → API en :9100, consola en http://localhost:9101 (ticketit / ticketit-dev-minio).
# Sin S3_ENDPOINT la evidencia vive en memoria (se pierde al reiniciar); en production es OBLIGATORIO.
# S3_ENDPOINT=localhost
# S3_PORT=9100
# S3_USE_SSL=false
# S3_ACCESS_KEY=ticketit
# S3_SECRET_KEY=ticketit-dev-minio
# S3_BUCKET=ticketit-evidence

# ── Sesión, contadores y tokens (Redis; sin él, en memoria) ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=ticketit:

# ── Secretos (OBLIGATORIOS en production; ≥ 32 caracteres) ──────────────────────────────────────────
# Se generan con:  node deploy/generate-secrets.mjs --domain tudominio.com --env
# SESSION_SECRET=
# TOTP_ENCRYPTION_KEY=       # cifra los secretos TOTP en reposo (AES-256-GCM): no la pierdas

# ── Cuentas y datos iniciales ───────────────────────────────────────────────────────────────────────
# Demostración (usuarios *@ticketit.dev con la clave pública `ticketit-dev` + tickets de ejemplo):
# activa por defecto en desarrollo, apagada en production.
# SEED_DEMO_DATA=true
# Cuentas iniciales de production, una por rol: [{ "name", "email", "role", "password" }] (secreto ticketit_seed_users)
# SEED_USERS_JSON=
# BOOTSTRAP_ADMIN_EMAIL=admin@ticketit.local
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Seguridad ───────────────────────────────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_GLOBAL_PER_MIN=300
# TRUST_PROXY=true           # detrás de Traefik/Caddy (obligatorio en production detrás de un proxy)
# API_DOCS_ENABLED=true      # Scalar UI en /api/reference (apagada por defecto en production)
