  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:pg": "cross-env DATABASE_URL=postgres://ticketit:ticketit-dev@localhost:5433/ticketit vitest run && cross-env DATABASE_URL=postgres://ticketit:ticketit-dev@localhost:5433/ticketit vitest run --config ./vitest.config.e2e.ts",
    "test:redis": "cross-env REDIS_URL=redis://localhost:6380 vitest run && cross-env REDIS_URL=redis://localhost:6380 vitest run --config ./vitest.config.e2e.ts",
    "docs:errors": "bun scripts/generate-error-catalog.ts",
    "typeorm": "bun node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "bun node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "bun node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:create": "bun node_modules/typeorm/cli.js migration:create",
    "typeorm": "bun node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "bun node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "bun node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:create": "bun node_modules/typeorm/cli.js migration:create"
  },
