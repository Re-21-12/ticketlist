# ── Ticketit · variables para Dokploy (pestaña «Environment» del compose) ───────────────────────────
# Los SECRETOS (clave de sesión, clave TOTP, cuentas iniciales por rol) NO van aquí: son archivos en
# `../files/secrets/` (ver DOKPLOY.md §3).

# Dominio público (sin https://)
TICKETIT_DOMAIN=tickets.tudominio.com

# Etiquetas de imagen (GHCR). `latest` (main), `dev` (develop) o `sha-abc1234` (un build exacto).
WEB_IMAGE_TAG=latest
API_IMAGE_TAG=latest

# ── Stack propio (docker-compose.dokploy.yml) ───────────────────────────────────────────────────────
DB_USER=ticketit
DB_NAME=ticketit
DB_PASSWORD=cambia-esto-por-una-clave-larga
REDIS_PASSWORD=cambia-esto-por-otra-clave-larga

# Las cuentas iniciales (una por rol) y sus claves están en el secreto ticketit_seed_users
# (node deploy/generate-secrets.mjs --domain tudominio.com).

# Datos de demostración (usuarios con clave PÚBLICA + tickets de ejemplo). Solo para un entorno de pruebas.
SEED_DEMO_DATA=false
LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_GLOBAL_PER_MIN=300
API_DOCS_ENABLED=false

# ── Integración con wallet-api (docker-compose.wallet-integration.yml) ──────────────────────────────
# Reutiliza DB_PASSWORD / DB_USER / REDIS_PASSWORD de wallet-api. Solo se agregan estas:
TICKETIT_IMAGE_TAG=latest
TICKETIT_DB_PASSWORD=cambia-esto-por-la-clave-del-rol-ticketit_app
TICKETIT_SEED_DEMO_DATA=false
